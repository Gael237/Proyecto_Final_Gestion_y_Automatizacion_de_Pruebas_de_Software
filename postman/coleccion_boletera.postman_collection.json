{
  "info": {
    "_postman_id": "b8e1a0d2-7c1f-4a2e-9d3e-1f6a3c2b9e10",
    "name": "La Boletera - API Tests",
    "description": "Suite de pruebas de API (caja negra) para el backend de venta de boletos de autobús (FastAPI). Cubre el flujo feliz y los casos borde/errores de los endpoints /autobuses/, /viajes/, /boletos/ y /buscar_viaje/. Pensada para ejecutarse con Postman o Newman en orden secuencial (usa variables de colección para encadenar IDs entre requests).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Genera una placa unica UNA sola vez por corrida de la coleccion y la",
          "// congela en una variable de coleccion, para que el request de 'placa",
          "// duplicada' reutilice exactamente el mismo valor (si se resolviera",
          "// {{$randomInt}} en cada request, nunca habria una duplicidad real).",
          "if (!pm.collectionVariables.get('placa_unica')) {",
          "    pm.collectionVariables.set('placa_unica', 'ABC-' + Math.floor(Math.random() * 1000000));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Tiempo de respuesta < 1000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(1000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "placa_unica", "value": "", "type": "string" },
    { "key": "autobus_id", "value": "", "type": "string" },
    { "key": "autobus_id_capacidad_1", "value": "", "type": "string" },
    { "key": "viaje_id", "value": "", "type": "string" },
    { "key": "viaje_id_capacidad_1", "value": "", "type": "string" },
    { "key": "viaje_id_sin_boletos", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01 - Autobuses",
      "item": [
        {
          "name": "Crear autobus valido -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Respuesta contiene id y placa registrada', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body.placa).to.eql(pm.collectionVariables.get('placa_unica'));",
                  "    pm.expect(body.capacidad).to.eql(20);",
                  "    pm.collectionVariables.set('autobus_id', body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"{{placa_unica}}\",\n  \"chofer\": \"Luis Hernandez\",\n  \"capacidad\": 20\n}"
            },
            "url": {
              "raw": "{{base_url}}/autobuses/",
              "host": ["{{base_url}}"],
              "path": ["autobuses", ""]
            }
          },
          "response": []
        },
        {
          "name": "Crear autobus con capacidad 1 (para prueba de limite) -> 200",
          "event": [
