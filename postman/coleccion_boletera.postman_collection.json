          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"CAP1-{{$randomInt}}\",\n  \"chofer\": \"Ana Torres\",\n  \"capacidad\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/autobuses/",
